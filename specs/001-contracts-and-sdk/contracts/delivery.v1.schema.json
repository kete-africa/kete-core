{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kete.africa/contracts/delivery.v1.schema.json",
  "title": "Kete event delivery, version 1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "https://kete.africa/contracts/event.v1.schema.json" }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "outcome"],
            "properties": {
              "id": { "type": "string" },
              "outcome": { "enum": ["accepted", "duplicate", "refused"] },
              "reason": {
                "enum": ["invalid_signature", "stale", "unknown_product", "invalid_payload", "undeclared_type", "batch_too_large"]
              }
            }
          }
        }
      }
    }
  }
}
