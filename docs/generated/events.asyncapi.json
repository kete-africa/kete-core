            "data"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "payment.succeeded"
            },
            "specversion": {
              "const": "1"
            },
            "product": {
              "type": "string",
