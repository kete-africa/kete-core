            },
            "organization": {
              "type": "string",
              "pattern": "^org_[A-Za-z0-9_-]{4,64}$"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "currency",
                "reference"
              ],
              "properties": {
                "amount": {
                  "type": "integer",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "reference": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            }
          }
        }
      },
      "PaymentFailed": {
