{
  "name": "@kete/app-template",
  "private": true,
  "type": "module",
  "description": "The template of a Kete App (spec 029): every building block of kete-core wired, one feature to replace.",
  "scripts": {
    "dev": "vite dev --port 3400",
    "build": "vite build",
    "start": "srvx serve --entry dist/server/server.js --static ../client --prod --host 0.0.0.0 --port 3000",
    "worker": "tsx src/worker/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "design:generate": "tsx scripts/design-generate.ts",
    "test": "vitest run",
    "typecheck": "vite build && tsc --noEmit"
  },
  "dependencies": {
    "@kete/admin": "workspace:@kete-africa/admin@*",
    "@kete/agents": "workspace:@kete-africa/agents@*",
    "@kete/ai": "workspace:@kete-africa/ai@*",
    "@kete/analytics": "workspace:@kete-africa/analytics@*",
    "@kete/auth": "workspace:@kete-africa/auth@*",
    "@kete/capabilities": "workspace:@kete-africa/capabilities@*",
    "@kete/center": "workspace:@kete-africa/center@*",
    "@kete/commands": "workspace:@kete-africa/commands@*",
    "@kete/design": "workspace:@kete-africa/design@*",
    "@kete/drafts": "workspace:@kete-africa/drafts@*",
    "@kete/feedback": "workspace:@kete-africa/feedback@*",
    "@kete/intelligence": "workspace:@kete-africa/intelligence@*",
    "@kete/jobs": "workspace:@kete-africa/jobs@*",
    "@kete/log": "workspace:@kete-africa/log@*",
    "@kete/metrics": "workspace:@kete-africa/metrics@*",
    "@kete/notify": "workspace:@kete-africa/notify@*",
    "@kete/records": "workspace:@kete-africa/records@*",
    "@kete/sdk": "workspace:@kete-africa/sdk@*",
    "@kete/shell": "workspace:@kete-africa/shell@*",
    "@kete/tenancy": "workspace:@kete-africa/tenancy@*",
    "@kete/views": "workspace:@kete-africa/views@*",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "0.11.22",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@kete/testing": "workspace:@kete-africa/testing@*",
    "@modelcontextprotocol/client": "2.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ai": "^7.0.122",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
