{
  "product": "prd_app_template",
  "name": "App template",
  "version": "0.1.0",
  "events": ["metrics.daily"],
  "governance": {
    "owner": {
      "name": "Kete"
    },
    "dataCategories": ["personal"],
    "ai": {
      "used": true,
      "purpose": "Answers questions with the readings the person may open (« Demander »), when a model is configured."
    },
    "criticality": "low"
  },
  "question": {
    "fr": "Que reste-t-il à faire ?",
    "en": "What is left to do?"
  },
  "places": [
    {
      "id": "tasks",
      "label": {
        "fr": "Tâches",
        "en": "Tasks"
      },
      "path": "/taches",
      "icon": "check"
    },
    {
      "id": "journal",
      "label": {
        "fr": "Journal",
        "en": "Journal"
      },
      "path": "/journal",
      "icon": "clock"
    },
    {
      "id": "closure",
      "label": {
        "fr": "Ma journée",
        "en": "My day"
      },
      "path": "/soir",
      "icon": "pen"
    }
  ],
  "metrics": [
    {
      "name": "tasks.open",
      "label": {
        "fr": "Tâches ouvertes",
        "en": "Open tasks"
      },
      "description": {
        "fr": "Les tâches de l’organisation qui ne sont pas faites.",
        "en": "The organization’s tasks not yet done."
      },
      "unit": "count",
      "better": "down"
    },
    {
      "name": "tasks.overdue",
      "label": {
        "fr": "Tâches en retard",
        "en": "Overdue tasks"
      },
      "description": {
        "fr": "Les tâches ouvertes dont l’échéance est passée.",
        "en": "The open tasks past their due day."
      },
      "unit": "count",
      "better": "down"
    }
  ]
}
