{
  "name": "@kete-africa/agents",
  "version": "0.5.7",
  "type": "module",
  "description": "Kete agents: a turn of an agent on a proven runtime (Mastra), with the caller's capabilities as its only tools, usage measured and budgets enforced, what the page shows as events, and its conversations kept under each organization's row-level security.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/agents"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@kete/ai": "workspace:@kete-africa/ai@*",
    "@kete/capabilities": "workspace:@kete-africa/capabilities@*",
    "@kete/records": "workspace:@kete-africa/records@*",
    "@kete/sandbox": "workspace:@kete-africa/sandbox@*",
    "@kete/tenancy": "workspace:@kete-africa/tenancy@*",
    "@kete/tools": "workspace:@kete-africa/tools@*",
    "@mastra/core": "1.76.0",
    "@mastra/memory": "1.37.0",
    "@mastra/pg": "1.31.0",
    "ai": "^7.0.122",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kete/testing": "workspace:@kete-africa/testing@*",
    "@types/pg": "^8.23.1"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
