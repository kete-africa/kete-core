{
  "name": "@kete-africa/boards",
  "version": "0.1.9",
  "type": "module",
  "description": "Kete boards (spec 103; doctrine D-052): one object for a board looked at live, sent by a routine and frozen as a summary — its cards and places, what changed since the last summary, when the routine runs next, and the summary as a document to index by choice.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/boards"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "dependencies": {
    "@kete/metrics": "workspace:@kete-africa/metrics@*",
    "@kete/sdk": "workspace:@kete-africa/sdk@*",
    "@kete/time": "workspace:@kete-africa/time@*"
  }
}
