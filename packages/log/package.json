{
  "name": "@kete-africa/log",
  "version": "0.1.1",
  "type": "module",
  "description": "Kete logs: structured logs behind a port (pino), secrets and personal data redacted, every line tied to its trace, errors reported with what they happened to.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/log"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@kete/testing": "workspace:@kete-africa/testing@*",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
}
