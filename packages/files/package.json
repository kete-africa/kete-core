{
  "name": "@kete-africa/files",
  "version": "0.2.0",
  "type": "module",
  "description": "Kete files: a storage port with an S3-compatible adapter, presigned transfers, images made safe, documents read page by page, final documents from Word templates, and PDF through a conversion service.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/files"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "docxtemplater": "^3.71.0",
    "mammoth": "^1.13.0",
    "pizzip": "^3.3.0",
    "sharp": "^0.35.5",
    "unpdf": "^1.8.1"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
}
