{
  "name": "@kete-africa/metrics",
  "version": "0.1.2",
  "type": "module",
  "description": "Kete metrics (spec 103; doctrine D-052): the figures an app declares in its manifest, computed by its code under the reader's rights, read over a period and compared with the one before — served at the app's /api/metrics and read by the center, never a query written by hand.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/metrics"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./server": {
        "types": "./dist/src/server.d.ts",
        "default": "./dist/src/server.js"
      }
    }
  },
  "dependencies": {
    "@kete/sdk": "workspace:@kete-africa/sdk@*"
  }
}
