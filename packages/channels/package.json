{
  "name": "@kete-africa/channels",
  "version": "0.1.2",
  "type": "module",
  "description": "Kete channels and the router (spec 113; doctrine D-056): what the outside says — WhatsApp, Telegram, mail by IMAP, forms — received once, tied by the router to its object's thread with a holder, by a rule, by the model's intent above a threshold, or by a person on a card « à classer » that becomes a rule; answers leave by mail from the person's box with the thread's address for replies.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/channels"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@kete/notify": "workspace:@kete-africa/notify@*",
    "@kete/records": "workspace:@kete-africa/records@*",
    "@kete/sdk": "workspace:@kete-africa/sdk@*",
    "@kete/tenancy": "workspace:@kete-africa/tenancy@*",
    "@kete/threads": "workspace:@kete-africa/threads@*",
    "@kete/work": "workspace:@kete-africa/work@*",
    "imapflow": "2.2.1",
    "mailparser": "3.9.33",
    "nodemailer": "10.0.13"
  },
  "devDependencies": {
    "@kete/testing": "workspace:@kete-africa/testing@*",
    "@types/mailparser": "3.9.0",
    "@types/nodemailer": "8.0.2"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
}
