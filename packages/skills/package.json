{
  "name": "@kete-africa/skills",
  "version": "0.1.0",
  "type": "module",
  "description": "Kete skills: Agent Skills folders read and validated, versioned in Postgres, offered to a model progressively, carried to a provider's sandbox for their scripts, and checked against their own test cases.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/skills"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@kete/ai": "workspace:@kete-africa/ai@*",
    "@kete/records": "workspace:@kete-africa/records@*",
    "@kete/tenancy": "workspace:@kete-africa/tenancy@*",
    "ai": "^7.0.122",
    "fflate": "^0.8.3",
    "skills-ref": "^0.1.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kete/testing": "workspace:@kete-africa/testing@*"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
}
