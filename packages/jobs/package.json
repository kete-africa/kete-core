  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/jobs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
