      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "dependencies": {
    "pg-boss": "12.35.0"
  },
  "devDependencies": {
    "@kete/notify": "workspace:@kete-africa/notify@*",
    "@kete/testing": "workspace:@kete-africa/testing@*",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@kete/notify": "workspace:@kete-africa/notify@*"
  },
  "peerDependenciesMeta": {
    "@kete/notify": {
      "optional": true
    }
  }
}
