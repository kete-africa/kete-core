{
  "name": "@kete-africa/design",
  "version": "0.1.0",
  "type": "module",
  "description": "Kete designs (doctrine D-035): kete and workspace, in three layers — base tokens (one DESIGN.md each), semantic tokens, React components that use semantic tokens only — and client brands with their contrasts checked.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kete-africa/kete-core.git",
    "directory": "packages/design"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./base.css": "./base.css",
    "./theme.gen.css": "./theme.gen.css",
    "./semantic.gen.css": "./semantic.gen.css",
    "./DESIGN.md": "./designs/kete/DESIGN.md",
    "./designs/*": "./designs/*"
  },
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "files": [
    "dist/src",
    "README.md",
    "src",
    "styles.css",
    "theme.gen.css",
    "semantic.gen.css",
    "designs",
    "base.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./styles.css": "./styles.css",
      "./base.css": "./base.css",
      "./theme.gen.css": "./theme.gen.css",
      "./semantic.gen.css": "./semantic.gen.css",
      "./DESIGN.md": "./designs/kete/DESIGN.md",
      "./designs/*": "./designs/*"
    }
  }
}
