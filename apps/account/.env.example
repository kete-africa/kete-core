# Application role (no BYPASSRLS) on the Neon project "kete-account".
ACCOUNT_DATABASE_URL="postgresql://account_app:...@host/account?sslmode=require"
# Owner role: migrations only (pnpm db:migrate).
ACCOUNT_OWNER_URL="postgresql://account_owner:...@host/account?sslmode=require"
# At least 32 random characters.
BETTER_AUTH_SECRET=""
# Public origin of the Compte Kete.
BETTER_AUTH_URL="http://localhost:3100"
# Object storage of the same Neon branch (GET /projects/{id}/branches/{branch}/storage gives the
# endpoint; a branch-scoped storage:read + storage:write credential gives the keys).
ACCOUNT_STORAGE_ENDPOINT="https://br-....storage.c-6.eu-central-1.aws.neon.tech"
ACCOUNT_STORAGE_REGION="eu-central-1"
ACCOUNT_STORAGE_BUCKET="files"
ACCOUNT_STORAGE_ACCESS_KEY_ID=""
ACCOUNT_STORAGE_SECRET_ACCESS_KEY=""
# Payment provider (Chariow): the store's API key, and the signing secret of the Pulse that points
# at /api/payments/notifications (not the API key).
PAYMENTS_CHARIOW_API_KEY=""
PAYMENTS_CHARIOW_PULSE_SECRET=""
# Kete's own organization: its owners and admins with two-factor on are Kete operators (they
# register apps and manage offers). Empty: nobody is an operator.
KETE_OPERATORS_ORGANIZATION_ID=""
# Development and tests only: an in-memory payment provider with these products (refused in
# production). E.g. [{"id":"prd_dev","name":"Nettio — 30 jours","price":{"value":5000,"currency":"XOF"}}]
# PAYMENTS_PROVIDER="fake"
# PAYMENTS_FAKE_PRODUCTS="[]"
# Kete Cockpit: where the outbox is delivered, and the key the Cockpit handed out when the Compte
# Kete was registered. Unset: events wait in the outbox.
KETE_EVENTS_URL=""
KETE_EVENTS_KID=""
KETE_EVENTS_SECRET=""
