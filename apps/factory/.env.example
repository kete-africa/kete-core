# The app factory (spec 048). Every value is set in the factory's hosting; none in a repository.
# Its own database (Neon): application role and owner role.
DATABASE_URL=
OWNER_DATABASE_URL=
# The key Kete Enterprise and the factory share (≥ 32 random bytes), and its id.
FACTORY_ENTERPRISE_KID=
FACTORY_ENTERPRISE_SECRET=
# GitHub App « kete-factory » installed on the organization; its private key (or a _PATH to it).
FACTORY_GITHUB_APP_ID=
FACTORY_GITHUB_INSTALLATION_ID=
FACTORY_GITHUB_PRIVATE_KEY=
FACTORY_REPOSITORY_OWNER=kete-africa
# Hosting (Coolify): a token reserved to the factory, and where apps go.
FACTORY_COOLIFY_URL=
FACTORY_COOLIFY_TOKEN=
FACTORY_COOLIFY_PROJECT=
FACTORY_COOLIFY_SERVER=
FACTORY_COOLIFY_ENVIRONMENT=staging
FACTORY_COOLIFY_GITHUB_APP=
# Databases of the apps (Neon).
FACTORY_NEON_API_KEY=
FACTORY_NEON_PROJECT=
FACTORY_NEON_BRANCH=dev
# The Compte Kete: the factory's own client (pnpm clients create --factory …).
FACTORY_ACCOUNT_URL=
FACTORY_ACCOUNT_CLIENT_ID=
FACTORY_ACCOUNT_CLIENT_SECRET=
# Sandboxes (boat.dev) and the coding agent:
# - integrated (default): the sandbox provider's own Codex, on the subscription its owner signed in
#   with on its Agents page; FACTORY_SANDBOX_TEMPLATE names the provider's environment that passes
#   the agents' sign-in and nothing else (no repositories, no secrets, no provider keys);
# - codex: Codex installed by the factory, with a ChatGPT auth.json (or a _PATH);
# - claude: Claude Code installed by the factory, with an Anthropic API key.
FACTORY_SANDBOX_API_KEY=
FACTORY_AGENT=integrated
FACTORY_SANDBOX_TEMPLATE=kete-factory
FACTORY_AGENT_MODEL=
FACTORY_CODEX_AUTH_JSON=
FACTORY_ANTHROPIC_API_KEY=
# Where the apps live and what they connect to.
FACTORY_APPS_DOMAIN=
FACTORY_ENVIRONMENT=staging
FACTORY_ENTERPRISE_API_URL=
KETE_PACKAGES_TOKEN=
KETE_OPERATORS_ORGANIZATION_ID=
