# Integration tests run against a real Postgres (Neon branch "test").
# Owner role: runs migrations. Application role: no BYPASSRLS.
KETE_TEST_OWNER_URL="postgresql://kete_owner:...@host/kete?sslmode=require"
KETE_TEST_APP_URL="postgresql://kete_app:...@host/kete?sslmode=require"
# Compte Kete (apps/account) integration tests: the kete-account Neon project, branch "test".
ACCOUNT_TEST_OWNER_URL="postgresql://account_owner:...@host/account?sslmode=require"
ACCOUNT_TEST_APP_URL="postgresql://account_app:...@host/account?sslmode=require"
# Better Auth secret shared by everything that runs against the account test branch (it encrypts
# the signing keys stored there).
ACCOUNT_TEST_AUTH_SECRET=""
