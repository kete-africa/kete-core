{
  "name": "kete-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm contracts:check && pnpm design:check && pnpm docs:check && pnpm i18n:check",
    "lint": "eslint .",
    "typecheck": "tsc -b && pnpm --filter @kete/account typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "contracts:generate": "tsx tooling/scripts/contracts-generate.ts",
    "contracts:check": "tsx tooling/scripts/contracts-generate.ts --check",
    "chaos": "tsx tooling/scripts/chaos.ts",
    "docs:check": "tsx tooling/scripts/check-readmes.ts",
    "design:generate": "tsx tooling/scripts/design-generate.ts",
    "design:check": "tsx tooling/scripts/design-generate.ts --check",
    "test:e2e": "pnpm --filter @kete/account test:e2e",
    "i18n:check": "tsx tooling/scripts/check-hardcoded-strings.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@google/design.md": "^0.4.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
