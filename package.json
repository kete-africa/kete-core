{
  "name": "kete-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm contracts:check && pnpm events:check && pnpm openapi:check && pnpm design:check && pnpm docs:check && pnpm i18n:check && pnpm knip && pnpm audit:check",
    "lint": "eslint .",
    "typecheck": "tsc -b && pnpm --filter @kete/account typecheck && pnpm --filter @kete/cockpit typecheck && pnpm --filter @kete/design-preview typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "contracts:generate": "tsx tooling/scripts/contracts-generate.ts",
    "contracts:check": "tsx tooling/scripts/contracts-generate.ts --check",
    "chaos": "tsx tooling/scripts/chaos.ts",
    "docs:check": "tsx tooling/scripts/check-readmes.ts",
    "design:generate": "tsx tooling/scripts/design-generate.ts",
    "design:check": "tsx tooling/scripts/design-generate.ts --check",
    "test:e2e": "pnpm --filter @kete/account test:e2e && pnpm --filter @kete/cockpit test:e2e",
    "i18n:check": "tsx tooling/scripts/check-hardcoded-strings.ts",
    "knip": "knip --no-progress",
    "audit:check": "pnpm audit --audit-level high",
    "changeset": "changeset",
    "release:version": "changeset version",
    "docs:dev": "pnpm --filter @kete/docs dev",
    "docs:build": "pnpm --filter @kete/docs build",
    "docs:preview": "pnpm --filter @kete/docs preview",
    "events:generate": "tsx tooling/scripts/events-generate.ts",
    "events:check": "tsx tooling/scripts/events-generate.ts --check",
    "openapi:generate": "tsx tooling/scripts/openapi-generate.ts",
    "openapi:check": "tsx tooling/scripts/openapi-generate.ts --check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@google/design.md": "^0.4.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "json-schema-to-typescript": "^15.0.4",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
